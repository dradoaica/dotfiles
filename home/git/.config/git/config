[user]
	name = dradoaica
	email = dradoaica@gmail.com
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[pull]
	ff = only
[fetch]
	prune = true
[diff]
	algorithm = histogram
	# Show moved lines in a different colour from added and removed ones
	colorMoved = default
[branch]
	# `git branch` lists the most recently committed-to branches first
	sort = -committerdate
[tag]
	# v1.10 after v1.9, not after v1.1
	sort = version:refname
[commit]
	# Show the diff being committed in the commit message editor
	verbose = true
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
# Use the GitHub CLI's login for HTTPS remotes; this is what `gh auth setup-git` would add
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
# Machine-specific or private settings (signing key, work email); not tracked.
# `git config --global` writes through the symlink into this repository, so use
# `git config --file ~/.config/git/config.local` for anything that should stay local.
[include]
	path = ~/.config/git/config.local
