# Rapoo mice (vendor 24ae): let the user at the seat open their raw HID devices, for Rapoo's WebHID driver at
# https://hub.rapoo.com in Chrome. Must sort before 73-seat-late.rules, which applies the uaccess tag.
# Based on https://github.com/pedro3z0/rapoo-software-linux, without its MODE="0666", which opens them to every local
# user and process, and with the kernel's uppercase hex in the Bluetooth match.

# USB: wired mouse, 2.4 GHz receiver dongle
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="24ae", TAG+="uaccess"

# Bluetooth (bus type 0005)
SUBSYSTEM=="hidraw", KERNELS=="0005:24AE:*", TAG+="uaccess"
